{{#> Container }}
    <div class="password-container">
        <h1>Change password</h1>

        {{> Input label="Old password"  name="oldPassword" type="password" value="12345" }}
        {{> Input label="New password"  name="newPassword" type="password" value="12345" }}
        {{> Input label="Confirm password"  name="confirmNewPassword" type="password" value="12345" }}

        <div class="profile-form__actions">
            {{> Button label="Change password" variant="primary" }}
            {{> Button label="Cancel" variant="error" }}
        </div>
    </div>
{{/ Container }}
{{> BackButton }}