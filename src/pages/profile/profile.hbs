{{#> Container }}
    <div class="profile-container">
    <h1>My profile</h1>
        <div class="profile-avatar">
            <img src="./avatar.png" alt="User Avatar" class="profile-avatar__image"/>
            {{> Button label="Change avatar" variant="primary" }}
        </div>
        {{> Input label="First name" readOnly=true name="first_name" value="John" }}
        {{> Input label="Second name" readOnly=true name="second_name" value="Doe" }}
        {{> Input label="Nickname" readOnly=true name="display_name" value="Johnny" }}  
        {{> Input label="Login" readOnly=true name="login" value="johndoe" }}
        {{> Input label="Email" readOnly=true name="email" value="john.doe@example.com" }}
        {{> Input label="Phone" readOnly=true name="phone" value="+1234567890" }}
        <div class="profile-form__actions">
            {{> Button label="Change profile" variant="primary" }}
            {{> Button label="Update password" variant="primary" }}
            {{> Button label="Logout" variant="error" }}
        </div>
    </div>
{{/ Container }}
{{> BackButton }}